<Window x:Class="KooliProjekt.WpfApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KooliProjekt.WpfApplication"
        mc:Ignorable="d"
        Title="Food items" Height="450" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="FoodItemsDataGrid"
                  Grid.Column="0"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="True"
                  ItemsSource="{Binding Data}"
                  SelectedItem="{Binding SelectedItem}"/>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock>ID</TextBlock>
            <TextBlock Text="{Binding SelectedItem.Id}"></TextBlock>
            <TextBlock>Name</TextBlock>
            <TextBox Text="{Binding SelectedItem.Name}"></TextBox>
            <TextBlock>Serving size</TextBlock>
            <TextBox Text="{Binding SelectedItem.ServingSize}"></TextBox>
            <TextBlock>Serving unit</TextBlock>
            <TextBox Text="{Binding SelectedItem.ServingUnit}"></TextBox>
            <TextBlock>Energy (kcal / sugars g / carbs g)</TextBlock>
            <TextBox Text="{Binding SelectedItem.Energy_Kcal_Per_Serving_Sugars_G_Per_Carbs_G}"></TextBox>

            <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">
                <Button Margin="5" Padding="5"
                        Command="{Binding AddNewCommand}">New</Button>
                <Button Margin="5" Padding="5"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding SelectedItem}">Save</Button>
                <Button Margin="5" Padding="5"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItem}">Delete</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
