@page "/fooditems/create"
@page "/fooditems/edit/{Id:int}"

@inject IApiClient<FoodItem> apiClient
@inject NavigationManager NavManager

<PageTitle>@title food item</PageTitle>

<h3>@title food item</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @item.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="item.Name" />
            <ValidationMessage For="@(() => item.Name)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Serving size</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="item.ServingSize" />
            <ValidationMessage For="@(() => item.ServingSize)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Serving unit</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="item.ServingUnit" />
            <ValidationMessage For="@(() => item.ServingUnit)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Energy kcal / sugars g / carbs g</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="item.Energy_Kcal_Per_Serving_Sugars_G_Per_Carbs_G" />
            <ValidationMessage For="@(() => item.Energy_Kcal_Per_Serving_Sugars_G_Per_Carbs_G)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="/fooditems">Back</a>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext editContext;
    private FoodItem item = new FoodItem();

    private ValidationMessageStore messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(item);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            return;
        }

        var response = await apiClient.Get(Id);
        if (response.HasErrors || response.Value == null)
        {
            error = "Kirjet ei leitud!";
            return;
        }

        item = response.Value;
        editContext = new EditContext(item);
        messageStore = new ValidationMessageStore(editContext);
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        error = "";
        messageStore?.Clear();

        var result = await apiClient.Save(item);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/fooditems");
            return;
        }

        // Üldised vead (nt API ei vasta) näidatakse kokkuvõttes
        foreach (var err in result.Errors ?? new List<string>())
        {
            messageStore?.Add(new FieldIdentifier(item, string.Empty), err);
        }

        // Väljade vead tulevad API-st camelCase nimedega, nt "name" -> "Name"
        foreach (var propertyError in result.PropertyErrors ?? new Dictionary<string, string>())
        {
            var propertyName = propertyError.Key[0].ToString().ToUpper() + propertyError.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(item, propertyName), propertyError.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
