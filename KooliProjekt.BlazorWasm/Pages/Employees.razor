@page "/employees"
@inject IApiClient<Employee> apiClient
@inject IJSRuntime JS

<PageTitle>Employees</PageTitle>

<h1>Employees</h1>

<p class="alert-danger">@error</p>

@if (items == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><a class="btn btn-primary" href="/employees/create">Add new</a></p>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Username</th>
                <th>Full name</th>
                <th>Password hash</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Username</td>
                    <td>@item.FullName</td>
                    <td>@item.PasswordHash</td>
                    <td>@item.Email</td>
                    <td>
                        <a class="btn btn-success" href="/employees/edit/@item.Id">Edit</a>
                        <button class="btn btn-danger" @onclick="() => Delete(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IList<Employee> items;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await apiClient.List(1, 100);
        if (result.HasErrors || result.Value == null)
        {
            error = "Viga andmete laadimisel!";
            items = new List<Employee>();
            return;
        }

        items = result.Value.Results;
    }

    private async Task Delete(Employee item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Oled kindel, et soovid kustutada " + item.FullName + "?");
        if (!confirmed)
        {
            return;
        }

        error = "";
        var result = await apiClient.Delete(item.Id);
        if (result.HasErrors)
        {
            error = "Viga kustutamisel!";
            return;
        }

        await LoadData();
    }
}
