@page "/fooditems"
@inject IApiClient<FoodItem> apiClient
@inject IJSRuntime JS

<PageTitle>Food items</PageTitle>

<h1>Food items</h1>

<p class="alert-danger">@error</p>

@if (items == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><a class="btn btn-primary" href="/fooditems/create">Add new</a></p>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Serving size</th>
                <th>Serving unit</th>
                <th>Energy kcal / sugars g / carbs g</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.ServingSize</td>
                    <td>@item.ServingUnit</td>
                    <td>@item.Energy_Kcal_Per_Serving_Sugars_G_Per_Carbs_G</td>
                    <td>
                        <a class="btn btn-success" href="/fooditems/edit/@item.Id">Edit</a>
                        <button class="btn btn-danger" @onclick="() => Delete(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IList<FoodItem> items;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await apiClient.List(1, 100);
        if (result.HasErrors || result.Value == null)
        {
            error = "Viga andmete laadimisel!";
            items = new List<FoodItem>();
            return;
        }

        items = result.Value.Results;
    }

    private async Task Delete(FoodItem item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Oled kindel, et soovid kustutada " + item.Name + "?");
        if (!confirmed)
        {
            return;
        }

        error = "";
        var result = await apiClient.Delete(item.Id);
        if (result.HasErrors)
        {
            error = "Viga kustutamisel!";
            return;
        }

        await LoadData();
    }
}
