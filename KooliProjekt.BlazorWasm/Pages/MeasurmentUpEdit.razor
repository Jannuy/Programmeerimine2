@page "/measurmentups/create"
@page "/measurmentups/edit/{Id:int}"

@inject IApiClient<MeasurmentUp> apiClient
@inject NavigationManager NavManager

<PageTitle>@title measurment up</PageTitle>

<h3>@title measurment up</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @item.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Measurment type ID</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="item.MeasurmentTypeId" />
            <ValidationMessage For="@(() => item.MeasurmentTypeId)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Employee ID</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="item.EmployeeId" />
            <ValidationMessage For="@(() => item.EmployeeId)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Measured at</label>
        <div class="col-sm-10">
            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="item.MeasuredAt" />
            <ValidationMessage For="@(() => item.MeasuredAt)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Notes</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="item.Notes" />
            <ValidationMessage For="@(() => item.Notes)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="/measurmentups">Back</a>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext editContext;
    private MeasurmentUp item = new MeasurmentUp();

    private ValidationMessageStore messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(item);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            item.MeasuredAt = DateTime.Now;
            return;
        }

        var response = await apiClient.Get(Id);
        if (response.HasErrors || response.Value == null)
        {
            error = "Kirjet ei leitud!";
            return;
        }

        item = response.Value;
        editContext = new EditContext(item);
        messageStore = new ValidationMessageStore(editContext);
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        error = "";
        messageStore?.Clear();

        var result = await apiClient.Save(item);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/measurmentups");
            return;
        }

        // Üldised vead (nt API ei vasta) näidatakse kokkuvõttes
        foreach (var err in result.Errors ?? new List<string>())
        {
            messageStore?.Add(new FieldIdentifier(item, string.Empty), err);
        }

        // Väljade vead tulevad API-st camelCase nimedega, nt "name" -> "Name"
        foreach (var propertyError in result.PropertyErrors ?? new Dictionary<string, string>())
        {
            var propertyName = propertyError.Key[0].ToString().ToUpper() + propertyError.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(item, propertyName), propertyError.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
